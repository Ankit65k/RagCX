import logging
import time
from typing import List, Any, Optional

from app.core.config.settings import settings
from app.models.base import LLMProvider
from app.questions.models import QuestionGenerationResult, LLMQuestionsResponse
from app.questions.exceptions import QuestionGenerationError
from app.questions.components.chunk_selector import RepresentativeChunkSelector
from app.questions.components.prompt_builder import QuestionPromptBuilder
from app.questions.components.validator import QuestionValidator
from app.questions.components.deduplicator import QuestionDeduplicator
from app.questions.components.ranker import QuestionRanker
from app.questions.components.formatter import QuestionFormatter

logger = logging.getLogger("app")


class QuestionGenerationPipeline:
    """
    Orchestrates the pipeline process for generating suggested questions grounded in a document.
    """

    def __init__(
        self,
        llm_provider: LLMProvider,
        chunk_selector: RepresentativeChunkSelector,
        prompt_builder: QuestionPromptBuilder,
        validator: QuestionValidator,
        deduplicator: QuestionDeduplicator,
        ranker: QuestionRanker,
        formatter: QuestionFormatter,
    ) -> None:
        self.llm_provider = llm_provider
        self.chunk_selector = chunk_selector
        self.prompt_builder = prompt_builder
        self.validator = validator
        self.deduplicator = deduplicator
        self.ranker = ranker
        self.formatter = formatter

    async def generate(self, chunks: List[Any], count: int = 4, request_id: str = "unknown") -> QuestionGenerationResult:
        logger.info(f"QuestionGeneration: Pipeline execution started. RequestId: {request_id}")
        start_time = time.perf_counter()

        # Enforce constraints: count default 5, maximum 10
        count = max(1, min(count, 10))

        # Fallback if the document lacks sufficient content
        if not chunks:
            logger.info("QuestionGeneration: Document lacks sufficient content. Returning fallback empty response.")
            return QuestionGenerationResult(
                questions=[],
                metadata={
                    "status": "FALLBACK_EMPTY_CONTENT",
                    "message": "The document lacks sufficient content to generate questions.",
                },
            )

        try:
            # 1. Chunk Selection
            selected_chunks = self.chunk_selector.select(chunks)
            if not selected_chunks:
                logger.info("QuestionGeneration: No representative chunks selected. Returning fallback empty response.")
                return QuestionGenerationResult(
                    questions=[],
                    metadata={
                        "status": "FALLBACK_NO_REPRESENTATIVE_CHUNKS",
                        "message": "The document lacks representative content chunks to generate questions.",
                    },
                )

            # 2. Prompt Assembly
            messages = self.prompt_builder.build(selected_chunks, count)

            # 3. LLM Question Generation with 120s timeout
            logger.info(f"[{request_id}] LLM generation started with 60-second timeout")

            try:
                raw_response = await self.llm_provider.chat(messages, timeout=60.0)
                raw_response = raw_response.strip()

                # Log raw LLM response for diagnostics
                logger.info(f"[{request_id}] LLM RAW RESPONSE ({len(raw_response)} chars): {raw_response[:500]}{'...' if len(raw_response) > 500 else ''}")
                logger.info(f"[{request_id}] LLM generation completed successfully")
            except Exception as e:
                error_msg = f"LLM generation failed: {str(e)}"
                logger.error(f"[{request_id}] LLM_GENERATION_FAILED: {error_msg}")
                # Return empty result instead of raising to prevent pipeline failure
                return QuestionGenerationResult(
                    questions=[],
                    metadata={
                        "status": "LLM_GENERATION_FAILED",
                        "message": error_msg,
                        "requestId": request_id,
                        "error": str(e),
                    },
                )

            # 4. Parse line-by-line response
            try:
                lines = [line.strip() for line in raw_response.split("\n") if line.strip()]

                # Remove numbering/bullets and create LLMQuestionItem objects
                from app.questions.models import LLMQuestionItem, ConfidenceLevel

                items = []
                available_pages = list(set([getattr(c, "pageNumber", 0) for c in selected_chunks]))

                for i, line in enumerate(lines):
                    # Remove leading numbers, dots, dashes, bullets, etc.
                    cleaned = line.lstrip("0123456789.-) *")

                    if len(cleaned) > 10:  # Filter out very short lines
                        # Assign all available pages (we don't know specific pages per question)
                        items.append(LLMQuestionItem(
                            question=cleaned,
                            related_pages=available_pages,
                            confidence=ConfidenceLevel.MEDIUM
                        ))

                # Log parsed result
                logger.info(f"[{request_id}] PARSED: {len(items)} questions from LLM (line-by-line)")
                for i, item in enumerate(items):
                    logger.debug(f"[{request_id}]   Parsed Q{i+1}: {item.question[:50]}...")

                if not items:
                    logger.warning(f"[{request_id}] No questions parsed from response")
                    return QuestionGenerationResult(
                        questions=[],
                        metadata={
                            "status": "NO_QUESTIONS_PARSED",
                            "message": "No valid questions could be extracted from LLM response",
                            "requestId": request_id,
                            "raw_response": raw_response[:500],
                        },
                    )

            except Exception as e:
                error_msg = f"Failed to parse LLM output: {str(e)}"
                logger.error(f"[{request_id}] PARSE_FAILED: {error_msg}")
                logger.error(f"[{request_id}] RAW_RESPONSE_THAT_FAILED: {raw_response[:1000]}")
                # Return empty result instead of raising
                return QuestionGenerationResult(
                    questions=[],
                    metadata={
                        "status": "PARSE_FAILED",
                        "message": error_msg,
                        "requestId": request_id,
                        "error": str(e),
                        "raw_response": raw_response[:500],
                    },
                )

            # 5. Validation
            valid_items = self.validator.validate_batch(items, selected_chunks, request_id=request_id)

            # 6. Deduplication (Semantic + String)
            deduplicated_items = await self.deduplicator.deduplicate(valid_items)

            # 7. Ranking
            ranked_items = self.ranker.rank(deduplicated_items)

            # Keep only the requested count
            ranked_items = ranked_items[:count]

            # 8. Formatting
            execution_time = (time.perf_counter() - start_time) * 1000.0
            result = self.formatter.format(
                items=ranked_items,
                execution_time_ms=execution_time,
                model_used=self.llm_provider.model,
                chunks=selected_chunks,
            )

            logger.info(f"QuestionGeneration: Pipeline finished successfully in {execution_time:.2f}ms.")
            return result

        except Exception as e:
            logger.error(f"QuestionGeneration: Pipeline execution failed: {str(e)}", exc_info=True)
            if not isinstance(e, QuestionGenerationError):
                raise QuestionGenerationError(f"Pipeline execution failed: {str(e)}") from e
            raise
