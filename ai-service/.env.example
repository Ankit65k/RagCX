# =============================================================================
# RagCX AI Service - Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control - it contains secrets!
# =============================================================================

# -----------------------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------------------
APP_ENV=development
APP_NAME=ragcx-ai-service
APP_VERSION=1.0.0
DEBUG=false
API_V1_STR=/api/v1
# Restrict this in production (e.g., ["http://localhost:3000", "https://yourdomain.com"])
BACKEND_CORS_ORIGINS=["*"]
TIMEZONE=UTC

# -----------------------------------------------------------------------------
# Redis Configuration
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_RECONNECT_RETRIES=5
REDIS_HEALTH_TIMEOUT=2.0

# -----------------------------------------------------------------------------
# LLM Provider Configuration
# -----------------------------------------------------------------------------
# Valid values: "ollama" or "gemini"
LLM_PROVIDER=ollama
LLM_FALLBACK=ollama

# Ollama Settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2:1b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TEMPERATURE=0.1
OLLAMA_TOP_P=0.9
OLLAMA_TOP_K=40
OLLAMA_CONTEXT_WINDOW=4096
OLLAMA_REQUEST_TIMEOUT=120.0
OLLAMA_KEEP_ALIVE=30m
OLLAMA_STREAMING=false
OLLAMA_NUM_PREDICT=300

# Gemini Settings (Optional - only needed if using Gemini as LLM provider)
# WARNING: Free tier may allow Google to train on your prompts.
# Use only for non-sensitive PDFs. Never commit a real API key to version control.
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
GEMINI_TOTAL_BUDGET=30.0
GEMINI_PER_ATTEMPT_CAP=20.0
GEMINI_MAX_OUTPUT_TOKENS=1500
GEMINI_THINKING_LEVEL=minimal

# -----------------------------------------------------------------------------
# Embedding Configuration
# -----------------------------------------------------------------------------
EMBEDDING_PROVIDER=Ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768
EMBEDDING_BATCH_SIZE=32
EMBEDDING_CHUNK_SIZE=800
EMBEDDING_CHUNK_OVERLAP=150

# -----------------------------------------------------------------------------
# ChromaDB Configuration
# -----------------------------------------------------------------------------
CHROMA_PERSIST_DIR=data/chroma
CHROMA_COLLECTION_NAME=ragcx_documents
CHROMA_DISTANCE_METRIC=cosine
CHROMA_TELEMETRY_DISABLED=true

# -----------------------------------------------------------------------------
# Document Processing Configuration
# -----------------------------------------------------------------------------
PROC_MAX_FILE_SIZE=20971520
PROC_MAX_PAGES=100
PROC_ALLOWED_EXTENSIONS=["pdf"]
PROC_ALLOWED_MIME_TYPES=["application/pdf"]
PROC_CONCURRENT_LIMIT=3

# -----------------------------------------------------------------------------
# LangGraph Configuration
# -----------------------------------------------------------------------------
LANGGRAPH_RECURSION_LIMIT=25
LANGGRAPH_MAX_ITERATIONS=10
LANGGRAPH_MEMORY_WINDOW=5
LANGGRAPH_CHECKPOINT_ENABLED=true

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_STRUCTURED=true
LOG_JSON=true