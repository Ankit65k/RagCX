# Application environment (development, production, etc.)
APP_ENV=development

# Port the backend server listens on
APP_PORT=4000

# Host the backend binds to
APP_HOST=localhost

# Base prefix. The routes add /v1 themselves, so the final URL is /api/v1.
APP_API_PREFIX=/api

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD_HERE@localhost:5432/ragcx

# Redis server hostname
REDIS_HOST=localhost

# Redis server port
REDIS_PORT=6379

# Redis password (if authentication is required)
REDIS_PASSWORD=YOUR_REDIS_PASSWORD_HERE

# Redis database number
REDIS_DB=0

# JWT access token secret key
JWT_ACCESS_SECRET=YOUR_JWT_ACCESS_SECRET_HERE

# JWT access token expiration time
JWT_ACCESS_EXPIRATION=7d

# JWT refresh token secret key
JWT_REFRESH_SECRET=YOUR_JWT_REFRESH_SECRET_HERE

# JWT refresh token expiration time
JWT_REFRESH_EXPIRATION=30d

# Storage provider (local, s3, etc.)
STORAGE_PROVIDER=local

# Local storage path for uploads
STORAGE_LOCAL_PATH=./uploads

# S3 bucket name (for S3 provider)
STORAGE_BUCKET=YOUR_S3_BUCKET_HERE

# S3 endpoint URL (for S3-compatible services)
STORAGE_ENDPOINT=YOUR_S3_ENDPOINT_HERE

# S3 region
STORAGE_REGION=YOUR_S3_REGION_HERE

# S3 access key ID
STORAGE_ACCESS_KEY_ID=YOUR_S3_ACCESS_KEY_ID_HERE

# S3 secret access key
STORAGE_SECRET_ACCESS_KEY=YOUR_S3_SECRET_ACCESS_KEY_HERE

# Log verbosity level (debug, info, warn, error)
LOG_LEVEL=info

# Bypass rate limiting (true/false) - for development only
BYPASS_RATE_LIMIT=false

# Maximum upload file size in bytes
UPLOAD_MAX_SIZE_BYTES=10485760

# Number of salt rounds for bcrypt password hashing
BCRYPT_SALT_ROUNDS=10

# Node environment (for compatibility with some libraries)
NODE_ENV=development